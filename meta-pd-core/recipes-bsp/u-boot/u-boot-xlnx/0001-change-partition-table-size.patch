From: Adam Schafer <ams-tech@users.noreply.github.com>
Date: Sun, 30 Nov 2025 17:06:36 -0500
Subject: [PATCH] change partition table size

---
 configs/xilinx_zynq_virt_defconfig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/configs/xilinx_zynq_virt_defconfig b/configs/xilinx_zynq_virt_defconfig
index 6c9c6f87ab8..20a0782277a 100644
--- a/configs/xilinx_zynq_virt_defconfig
+++ b/configs/xilinx_zynq_virt_defconfig
@@ -4,6 +4,7 @@ CONFIG_SYS_L2CACHE_OFF=y
 CONFIG_ARCH_ZYNQ=y
 CONFIG_TEXT_BASE=0x4000000
 CONFIG_SF_DEFAULT_SPEED=30000000
+CONFIG_ENV_SIZE=0x4000
 CONFIG_ENV_OFFSET=0x800000
 CONFIG_DM_GPIO=y
 CONFIG_DEFAULT_DEVICE_TREE="zynq-zc706"
@@ -89,9 +90,8 @@ CONFIG_OF_LIST="zynq-zc702 zynq-zc706 zynq-zc770-xm010 zynq-zc770-xm011 zynq-zc7
 CONFIG_ENV_IS_IN_FAT=y
 CONFIG_ENV_IS_IN_MMC=y
 CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
+CONFIG_ENV_FAT_DEVICE_AND_PART="0:1"
 CONFIG_SYS_RELOC_GD_ENV_ADDR=y
-CONFIG_USE_ENV_MMC_PARTITION=y
-CONFIG_ENV_MMC_PARTITION="0"
 CONFIG_NETCONSOLE=y
 CONFIG_SYS_FAULT_ECHO_LINK_DOWN=y
 CONFIG_NET_RANDOM_ETHADDR=y
