From 65d5148ee6bd91bdf70e5c4927eeb2e19a48762e Mon Sep 17 00:00:00 2001
From: Kas User <kas@example.com>
Date: Sat, 29 Nov 2025 04:55:21 -0500
Subject: [PATCH] add mender settings

---
 configs/xilinx_zynq_virt_defconfig | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/configs/xilinx_zynq_virt_defconfig b/configs/xilinx_zynq_virt_defconfig
index ed3d1019485..592da3b056b 100644
--- a/configs/xilinx_zynq_virt_defconfig
+++ b/configs/xilinx_zynq_virt_defconfig
@@ -4,7 +4,7 @@ CONFIG_SYS_L2CACHE_OFF=y
 CONFIG_ARCH_ZYNQ=y
 CONFIG_TEXT_BASE=0x4000000
 CONFIG_SF_DEFAULT_SPEED=30000000
