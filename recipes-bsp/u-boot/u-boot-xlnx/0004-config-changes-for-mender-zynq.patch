From 81faf7293b960ee2cb78ec9ffb75750578c9e98e Mon Sep 17 00:00:00 2001
From: Kas User <kas@example.com>
Date: Sun, 23 Nov 2025 06:59:09 -0500
Subject: [PATCH] config changes for mender-zynq

---
 configs/xilinx_zynq_virt_defconfig | 11 ++++-------
 include/configs/zynq-common.h      |  3 +++
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/configs/xilinx_zynq_virt_defconfig b/configs/xilinx_zynq_virt_defconfig
index ed3d1019485..3dffee82a4a 100644
--- a/configs/xilinx_zynq_virt_defconfig
+++ b/configs/xilinx_zynq_virt_defconfig
@@ -4,7 +4,7 @@ CONFIG_SYS_L2CACHE_OFF=y
 CONFIG_ARCH_ZYNQ=y
 CONFIG_TEXT_BASE=0x4000000
 CONFIG_SF_DEFAULT_SPEED=30000000
-CONFIG_ENV_OFFSET=0xE00000
+CONFIG_ENV_OFFSET=0x800000
 CONFIG_DM_GPIO=yls
 CONFIG_DEFAULT_DEVICE_TREE="zynq-zc706"
 CONFIG_OF_LIBFDT_OVERLAY=y
@@ -17,7 +17,7 @@ CONFIG_SPL_STACK_R=y
 CONFIG_SYS_BOOTM_LEN=0x3c00000
 CONFIG_SYS_LOAD_ADDR=0x0
 CONFIG_SPL=y
-CONFIG_ENV_OFFSET_REDUND=0xE40000
+CONFIG_ENV_OFFSET_REDUND=0x1000000
 CONFIG_CMD_FRU=y
 CONFIG_CMD_ZYNQ_AES=y
 CONFIG_SYS_MEMTEST_START=0x00000000
@@ -86,10 +86,7 @@ CONFIG_CMD_MTDPARTS_SHOW_NET_SIZES=y
 CONFIG_CMD_UBI=y
 CONFIG_OF_BOARD=y
 CONFIG_OF_LIST="zynq-zc702 zynq-zc706 zynq-zc770-xm010 zynq-zc770-xm011 zynq-zc770-xm011-x16 zynq-zc770-xm012 zynq-zc770-xm013 zynq-cc108 zynq-microzed zynq-minized zynq-picozed zynq-zed zynq-zturn zynq-zturn-v5 zynq-zybo zynq-zybo-z7 zynq-dlc20-rev1.0"
-CONFIG_ENV_IS_NOWHERE=y
-CONFIG_ENV_IS_IN_FAT=y
-CONFIG_ENV_IS_IN_NAND=y
-CONFIG_ENV_IS_IN_SPI_FLASH=y
+CONFIG_ENV_IS_IN_MMC=y
 CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
 CONFIG_SYS_RELOC_GD_ENV_ADDR=y
 CONFIG_NETCONSOLE=y
@@ -158,4 +155,4 @@ CONFIG_USB_GADGET_PRODUCT_NUM=0x0300
 CONFIG_CI_UDC=y
 CONFIG_USB_GADGET_DOWNLOAD=y
 CONFIG_SYS_TIMER_COUNTS_DOWN=y
-CONFIG_SPL_GZIP=y
+CONFIG_SPL_GZIP=y
\ No newline at end of file
diff --git a/include/configs/zynq-common.h b/include/configs/zynq-common.h
index 37c77aa1611..0b920b2ba5c 100644
--- a/include/configs/zynq-common.h
+++ b/include/configs/zynq-common.h
@@ -18,6 +18,9 @@
 #define CFG_SYS_TIMERBASE		ZYNQ_SCUTIMER_BASEADDR
 #define CFG_SYS_TIMER_COUNTER	(CFG_SYS_TIMERBASE + 0x4)
 
+#define CONFIG_BOOTCOUNT_LIMIT
+#define CONFIG_BOOTCOUNT_ENV
+
 /* GUIDs for capsule updatable firmware images */
 #define XILINX_BOOT_IMAGE_GUID \
 	EFI_GUID(0x1ba29a15, 0x9969, 0x40aa, 0xb4, 0x24, \
