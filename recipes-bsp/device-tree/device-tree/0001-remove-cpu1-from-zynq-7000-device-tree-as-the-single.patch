From fc78d8ffc83c183ee61e218cc5b6d54df970b377 Mon Sep 17 00:00:00 2001
From: Adam Schafer <ams-tech@users.noreply.github.com>
Date: Fri, 11 Oct 2024 05:17:37 -0400
Subject: [PATCH] remove cpu1 from zynq-7000 device tree, as the single-core 7S
 on the Cora Z7 does not have a cpu1

---
 device_tree/data/kernel_dtsi/2024.2/zynq/zynq-7000.dtsi | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/device_tree/data/kernel_dtsi/2024.2/zynq/zynq-7000.dtsi b/device_tree/data/kernel_dtsi/2024.2/zynq/zynq-7000.dtsi
index fa83f25..6f5d21c 100644
--- a/device_tree/data/kernel_dtsi/2024.2/zynq/zynq-7000.dtsi
+++ b/device_tree/data/kernel_dtsi/2024.2/zynq/zynq-7000.dtsi
@@ -42,13 +42,6 @@
 				333334  1000000
 			>;
 		};
-
-		cpu1: cpu@1 {
-			compatible = "arm,cortex-a9";
-			device_type = "cpu";
-			reg = <1>;
-			clocks = <&clkc 3>;
-		};
 	};
 
 	fpga_full: fpga-region {
@@ -564,7 +557,7 @@
 			reg = <0xf889d000 0x1000>;
 			clocks = <&clkc 27>, <&clkc 46>, <&clkc 47>;
 			clock-names = "apb_pclk", "dbg_trc", "dbg_apb";
-			cpu = <&cpu1>;
+			cpu = <&cpu0>;
 			out-ports {
 				port {
 					ptm1_out_port: endpoint {
